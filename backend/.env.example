# App
app_name=buck-e
app_version=0.1.0
debug=true

# Firestore / GCP
gcp_project_id=your-gcp-project-id
google_application_credentials=/absolute/path/to/service-account.json
firestore_database_id=(default)

# Set this to run against a local Firestore emulator instead of real GCP.
# When set, google_application_credentials above is ignored (no real
# credentials are needed); gcp_project_id is still used if set.
# firestore_emulator_host=localhost:8080

#Email filtering
allowed_email_domains=example.com,example.org
